# Hugo build output — regenerated by CI (hugo --minify) on every push; never served from git
/public/
/.hugo-test-public/
# Hugo cache / temp
/resources/_gen/
.hugo_build.lock
**/__pycache__/
# 源書抽取的中繼索引 — 由 tools/cscs_extract_source.py 重生，且內容衍生自版權書
tools/_source_index.json

# 逐章派工 prompt — 由 tools/cscs_delegate_prompt.md 套版重生
/.prompts/
